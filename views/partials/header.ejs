<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Campus Lost & Found / Marketplace</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
  <div class="container">
    <a class="navbar-brand" href="/">🎓 Campus Hub</a>
    <div class="navbar-nav ms-auto d-flex flex-row gap-1 align-items-center">
      <a class="nav-link" href="/items">Lost &amp; Found</a>
      <a class="nav-link" href="/marketplace">Marketplace</a>
      <% if (user) { %>
        <a class="nav-link" href="/chat">Messages</a>
        <% if (user.role === 'admin') { %><a class="nav-link" href="/admin">Admin</a><% } %>
        <span class="navbar-text text-light me-2">Hi, <%= user.name %></span>
        <form method="POST" action="/logout" class="d-inline">
          <button class="btn btn-sm btn-outline-light">Logout</button>
        </form>
      <% } else { %>
        <a class="nav-link" href="/login">Login</a>
        <a class="nav-link" href="/register">Register</a>
      <% } %>
    </div>
  </div>
</nav>
<div class="container pb-5">
