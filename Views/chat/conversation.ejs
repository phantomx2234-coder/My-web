<%- include('../partials/header') %>
<h2>Conversation</h2>
<div id="messages" class="border rounded p-3 mb-3" style="height:400px; overflow-y:auto;">
<% messages.forEach(m => { %>
  <div class="mb-2 <%= m.sender_id === user.id ? 'text-end' : '' %>">
    <span class="badge bg-<%= m.sender_id === user.id ? 'primary' : 'secondary' %>"><%= m.sender_name %></span>
    <div><%= m.content %></div>
  </div>
<% }) %>
</div>
<form id="msgForm" method="POST" action="/chat/<%= convo.id %>/message" class="d-flex gap-2">
  <input class="form-control" name="content" id="content" autocomplete="off" required>
  <button class="btn btn-primary">Send</button>
</form>

<script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
<script>
  const socket = io();
  const convoId = <%= convo.id %>;
  const currentUserId = <%= user.id %>;
  socket.emit('join', convoId);

  const messagesDiv = document.getElementById('messages');

  socket.on('new-message', (msg) => {
    // Avoid duplicating the message we just sent ourselves (page reload already shows it)
    if (msg.sender_id === currentUserId) return;
    const div = document.createElement('div');
    div.className = 'mb-2';
    div.innerHTML = `<span class="badge bg-secondary">${msg.sender_name}</span><div>${msg.content}</div>`;
    messagesDiv.appendChild(div);
    messagesDiv.scrollTop = messagesDiv.scrollHeight;
  });

  messagesDiv.scrollTop = messagesDiv.scrollHeight;
</script>
<%- include('../partials/footer') %>
