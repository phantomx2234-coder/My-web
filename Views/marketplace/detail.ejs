<%- include('../partials/header') %>
<% if (flagged) { %><div class="alert alert-info">Thanks — this post has been flagged for admin review.</div><% } %>

<div class="row">
  <div class="col-md-6">
    <% if (listing.image_path) { %><img src="<%= listing.image_path %>" class="img-fluid rounded mb-3"><% } %>
  </div>
  <div class="col-md-6">
    <span class="badge bg-info text-dark"><%= listing.transaction_type %></span>
    <h2><%= listing.title %></h2>
    <p class="fs-4 fw-bold">₹<%= listing.price %></p>
    <p><%= listing.description %></p>
    <p><strong>Condition:</strong> <%= listing.condition %></p>
    <p><strong>Category:</strong> <%= listing.category %></p>
    <p><strong>Seller:</strong> <%= listing.owner_name %></p>
    <p><strong>Status:</strong> <%= listing.status %></p>

    <% if (user && user.id !== listing.owner_id) { %>
      <form method="POST" action="/chat/start" class="d-inline">
        <input type="hidden" name="item_type" value="listing">
        <input type="hidden" name="item_id" value="<%= listing.id %>">
        <button class="btn btn-primary mb-2">Message Seller</button>
      </form>
      <hr>
      <form method="POST" action="/marketplace/<%= listing.id %>/flag">
        <input class="form-control mb-2" name="reason" placeholder="Reason for flagging (optional)">
        <button class="btn btn-sm btn-outline-danger">Flag as inappropriate</button>
      </form>
    <% } %>

    <% if (user && user.id === listing.owner_id) { %>
      <hr><h5>Update Status</h5>
      <form method="POST" action="/marketplace/<%= listing.id %>/status">
        <select name="status" class="form-select mb-2">
          <option value="available" <%= listing.status==='available'?'selected':'' %>>Available</option>
          <option value="pending" <%= listing.status==='pending'?'selected':'' %>>Pending</option>
          <option value="sold" <%= listing.status==='sold'?'selected':'' %>>Sold/Rented</option>
        </select>
        <button class="btn btn-outline-primary">Update</button>
      </form>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
