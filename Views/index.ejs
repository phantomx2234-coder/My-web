<%- include('partials/header') %>
<div class="p-5 mb-4 bg-light rounded-3">
  <h1>Campus Lost & Found + Marketplace</h1>
  <p class="lead">Report lost items, help others find theirs, and buy/sell/rent within campus — all with campus-verified accounts.</p>
  <a href="/items" class="btn btn-primary me-2">Browse Lost & Found</a>
  <a href="/marketplace" class="btn btn-success">Browse Marketplace</a>
  <% if (!user) { %>
    <p class="mt-3 text-muted">New here? <a href="/register">Register with your campus email</a> to post items or chat with sellers.</p>
  <% } %>
</div>
<%- include('partials/footer') %>
