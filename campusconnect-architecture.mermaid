flowchart TB
    Browser(["Student / Admin Browser"])

    subgraph FE["FRONTEND — Django Templates + Bootstrap"]
        Dashboard["Dashboard"]
        LFPages["Lost and Found Pages"]
        MPPages["Marketplace Pages"]
        StorePages["Campus Store Pages"]
        SearchUI["Search and Filter UI"]
        ChatUI["Chat UI"]
        AdminUI["Admin Panel UI"]
    end

    subgraph BE["BACKEND — Python + Django"]
        AuthApp["User Module<br/>Auth and Profiles"]
        LFApp["Lost and Found Module"]
        MPApp["Marketplace Module"]
        StoreApp["Campus Store Module"]
        SearchApp["Search and Filter Module"]
        ChatApp["Communication Module<br/>Django Channels"]
        AdminApp["Admin Module<br/>Django Admin"]
    end

    subgraph DATA["DATA LAYER"]
        ORM["Django ORM"]
        DB[("PostgreSQL")]
    end

    Browser --> Dashboard & LFPages & MPPages & StorePages & SearchUI & AdminUI
    Browser <-->|WebSocket| ChatUI

    Dashboard --> AuthApp
    LFPages --> LFApp
    MPPages --> MPApp
    StorePages --> StoreApp
    SearchUI --> SearchApp
    ChatUI <--> ChatApp
    AdminUI --> AdminApp

    AuthApp & LFApp & MPApp & StoreApp & SearchApp & ChatApp & AdminApp --> ORM
    ORM --> DB

    classDef frontend fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
    classDef backend fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef data fill:#fef3c7,stroke:#d97706,color:#78350f
    classDef client fill:#f3e8ff,stroke:#9333ea,color:#581c87

    class Browser client
    class Dashboard,LFPages,MPPages,StorePages,SearchUI,ChatUI,AdminUI frontend
    class AuthApp,LFApp,MPApp,StoreApp,SearchApp,ChatApp,AdminApp backend
    class ORM,DB data
